{
  "name": "sublink-worker",
  "version": "2.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-vercel.mjs",
    "deploy": "npm run setup-kv && wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "setup-kv": "node scripts/setup-kv.cjs",
    "build:node": "node_modules/.bin/esbuild src/platforms/node-server.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist/node-server.cjs",
    "dev:node": "npm run build:node && node dist/node-server.cjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.15",
    "@cloudflare/workers-types": "^4.20260418.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "esbuild": "^0.27.7",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.83.0"
  },
  "dependencies": {
    "esbuild-register": "^3.6.0",
    "hono": "^4.12.14",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "valibot": "^1.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}
